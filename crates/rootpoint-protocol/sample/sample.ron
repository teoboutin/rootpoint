#![enable(unwrap_variant_newtypes)]
(
    version: 3,
    aspect: (
        width: 16,
        height: 9,
    ),
    next_id: 20,
    assets: {
        19: (
            source: Path("splits.png"),
        ),
    },
    styles: {
        "Body": (
            font: Builtin("sans"),
            size: 40.0,
            bold: false,
            italic: false,
            colour: (
                r: 0,
                g: 0,
                b: 0,
                a: 255,
            ),
            h_align: Left,
            v_align: Top,
        ),
        "Legend": (
            font: Builtin("sans"),
            size: 28.0,
            bold: false,
            italic: true,
            colour: (
                r: 0,
                g: 0,
                b: 0,
                a: 255,
            ),
            h_align: Center,
            v_align: Top,
        ),
        "Subtitle": (
            font: Builtin("sans"),
            size: 64.0,
            bold: false,
            italic: false,
            colour: (
                r: 0,
                g: 0,
                b: 0,
                a: 255,
            ),
            h_align: Center,
            v_align: Top,
        ),
        "Title": (
            font: Builtin("sans"),
            size: 120.0,
            bold: true,
            italic: false,
            colour: (
                r: 0,
                g: 0,
                b: 0,
                a: 255,
            ),
            h_align: Center,
            v_align: Middle,
        ),
    },
    slides: [
        (
            id: 1,
            root: Split(
                id: 4,
                axis: TopToBottom,
                children: [
                    Area(
                        id: 2,
                        content: Text(
                            text: "rootpoint",
                            style: Named("Title"),
                        ),
                    ),
                    Split(
                        id: 6,
                        axis: LeftToRight,
                        children: [
                            Area(
                                id: 3,
                                content: Text(
                                    text: "A slide is a tree of splits. Select an area and split it: the split buttons of the side panel, or Shift and an arrow, cut it at its middle. Ctrl or Shift and a click cut it where you click; hold Alt to snap.",
                                    style: Named("Body"),
                                ),
                            ),
                            Area(
                                id: 5,
                                content: Text(
                                    text: "Click an area, or its row in the outline of the side panel, to select it. Alt+Up and Alt+Down select its siblings, Alt+Left its parent and Alt+Right a child, as the outline reads.",
                                    style: Named("Body"),
                                ),
                            ),
                        ],
                        dividers: [
                            0.5,
                        ],
                    ),
                ],
                dividers: [
                    0.3,
                ],
            ),
        ),
        (
            id: 7,
            root: Split(
                id: 10,
                axis: TopToBottom,
                children: [
                    Area(
                        id: 8,
                        content: Text(
                            text: "Dividers and moving",
                            style: Custom(
                                font: Builtin("sans"),
                                size: 80.0,
                                bold: true,
                                italic: false,
                                colour: (
                                    r: 42,
                                    g: 157,
                                    b: 143,
                                    a: 255,
                                ),
                                h_align: Left,
                                v_align: Middle,
                            ),
                        ),
                    ),
                    Split(
                        id: 12,
                        axis: LeftToRight,
                        children: [
                            Area(
                                id: 9,
                                content: Text(
                                    text: "Drag a divider to resize the areas on each side; Esc cancels the drag, and a double-click puts the divider halfway.",
                                    style: Named("Body"),
                                ),
                            ),
                            Area(
                                id: 11,
                                content: Text(
                                    text: "Drag an area\'s grip onto another area to swap them, or onto its edge to move it there. The hint says what the drop will do.",
                                    style: Custom(
                                        font: Builtin("sans"),
                                        size: 40.0,
                                        bold: false,
                                        italic: true,
                                        colour: (
                                            r: 38,
                                            g: 70,
                                            b: 83,
                                            a: 255,
                                        ),
                                        h_align: Left,
                                        v_align: Top,
                                    ),
                                ),
                            ),
                        ],
                        dividers: [
                            0.5,
                        ],
                    ),
                ],
                dividers: [
                    0.25,
                ],
            ),
        ),
        (
            id: 13,
            root: Split(
                id: 16,
                axis: TopToBottom,
                children: [
                    Split(
                        id: 18,
                        axis: LeftToRight,
                        children: [
                            Area(
                                id: 14,
                                content: Image(
                                    asset: 19,
                                    fit: Fit,
                                ),
                            ),
                            Area(
                                id: 17,
                                content: Image(
                                    asset: 19,
                                    fit: Fill,
                                ),
                            ),
                        ],
                        dividers: [
                            0.5,
                        ],
                    ),
                    Area(
                        id: 15,
                        content: Text(
                            text: "The same image in fit, left, and in fill, right.",
                            style: Custom(
                                font: Builtin("sans"),
                                size: 36.0,
                                bold: false,
                                italic: false,
                                colour: (
                                    r: 0,
                                    g: 0,
                                    b: 0,
                                    a: 255,
                                ),
                                h_align: Center,
                                v_align: Middle,
                            ),
                        ),
                    ),
