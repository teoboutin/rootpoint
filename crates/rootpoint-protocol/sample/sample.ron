#![enable(implicit_some)]
#![enable(unwrap_variant_newtypes)]
(
    version: 6,
    aspect: (
        width: 16,
        height: 9,
    ),
    next_id: 38,
    assets: {
        19: (
            path: "splits.png",
        ),
    },
    styles: {
        "Body": (
            font: Builtin("sans"),
            size: 40.0,
            bold: false,
            italic: false,
            colour: (
                r: 0,
                g: 0,
                b: 0,
                a: 255,
            ),
            h_align: Left,
            v_align: Top,
        ),
        "Legend": (
            font: Builtin("sans"),
            size: 28.0,
            bold: false,
            italic: true,
            colour: (
                r: 0,
                g: 0,
                b: 0,
                a: 255,
            ),
            h_align: Center,
            v_align: Top,
        ),
        "Subtitle": (
            font: Builtin("sans"),
            size: 64.0,
            bold: false,
            italic: false,
            colour: (
                r: 0,
                g: 0,
                b: 0,
                a: 255,
            ),
            h_align: Center,
            v_align: Top,
        ),
        "Title": (
            font: Builtin("sans"),
            size: 120.0,
            bold: true,
            italic: false,
            colour: (
                r: 0,
                g: 0,
                b: 0,
                a: 255,
            ),
            h_align: Center,
            v_align: Middle,
        ),
    },
    span_styles: {
        "Key": (
            bold: true,
            colour: (
                r: 42,
                g: 157,
                b: 143,
                a: 255,
            ),
        ),
    },
    slides: [
        (
            id: 1,
            root: Split(
                id: 4,
                axis: TopToBottom,
                children: [
                    Area(
                        id: 2,
                        content: Text(
                            root: [
                                Chars("rootpoint"),
                            ],
                            style: Named("Title"),
                        ),
                    ),
                    Split(
                        id: 6,
                        axis: LeftToRight,
                        children: [
                            Area(
                                id: 3,
                                content: Text(
                                    root: [
                                        Chars("A slide is a tree of splits. Select an area and split it: the split buttons of the side panel, or Shift and an arrow, cut it at its middle. Ctrl or Shift and a click cut it where you click; hold Alt to snap."),
                                    ],
                                    style: Named("Body"),
                                ),
                            ),
                            Area(
                                id: 5,
                                content: Text(
                                    root: [
                                        Chars("Click an area, or its row in the outline of the side panel, to select it. Alt+Up and Alt+Down select its siblings, Alt+Left its parent and Alt+Right a child, as the outline reads."),
                                    ],
                                    style: Named("Body"),
                                ),
                            ),
                        ],
                        dividers: [
                            0.5,
                        ],
                    ),
                ],
                dividers: [
                    0.3,
                ],
            ),
        ),
        (
            id: 7,
            root: Split(
                id: 10,
                axis: TopToBottom,
                children: [
                    Area(
                        id: 8,
                        content: Text(
                            root: [
                                Chars("Dividers and moving"),
                            ],
                            style: Custom(
                                font: Builtin("sans"),
                                size: 80.0,
                                bold: true,
                                italic: false,
                                colour: (
                                    r: 42,
                                    g: 157,
                                    b: 143,
                                    a: 255,
                                ),
                                h_align: Left,
                                v_align: Middle,
                            ),
                        ),
                    ),
                    Split(
                        id: 12,
                        axis: LeftToRight,
                        children: [
                            Area(
                                id: 9,
                                content: Text(
                                    root: [
                                        Chars("Drag a divider to resize the areas on each side; Esc cancels the drag, and a double-click puts the divider halfway."),
                                    ],
                                    style: Named("Body"),
                                ),
                            ),
                            Area(
                                id: 11,
                                content: Text(
                                    root: [
                                        Chars("Drag an area\'s grip onto another area to swap them, or onto its edge to move it there. The hint says what the drop will do."),
                                    ],
                                    style: Custom(
                                        font: Builtin("sans"),
                                        size: 40.0,
                                        bold: false,
                                        italic: true,
                                        colour: (
                                            r: 38,
                                            g: 70,
                                            b: 83,
                                            a: 255,
                                        ),
                                        h_align: Left,
                                        v_align: Top,
                                    ),
                                ),
                            ),
                        ],
                        dividers: [
                            0.5,
                        ],
                    ),
                ],
                dividers: [
                    0.25,
                ],
            ),
        ),
        (
            id: 13,
            root: Split(
                id: 16,
                axis: TopToBottom,
                children: [
                    Split(
                        id: 18,
                        axis: LeftToRight,
                        children: [
                            Area(
                                id: 14,
                                content: Image(
                                    asset: 19,
                                    fit: Fit,
                                ),
                            ),
                            Area(
                                id: 17,
                                content: Image(
                                    asset: 19,
                                    fit: Fill,
                                ),
                            ),
                        ],
                        dividers: [
                            0.5,
                        ],
                    ),
                    Area(
                        id: 15,
                        content: Text(
                            root: [
                                Chars("The same image in fit, left, and in fill, right."),
                            ],
                            style: Custom(
                                font: Builtin("sans"),
                                size: 36.0,
                                bold: false,
                                italic: false,
                                colour: (
                                    r: 0,
                                    g: 0,
                                    b: 0,
                                    a: 255,
                                ),
                                h_align: Center,
                                v_align: Middle,
                            ),
                        ),
                    ),
                ],
                dividers: [
                    0.8,
                ],
            ),
        ),
        (
            id: 20,
            root: Split(
                id: 23,
                axis: TopToBottom,
                children: [
                    Area(
                        id: 21,
                        content: Text(
                            root: [
                                Chars("Where it is saved"),
                            ],
                            style: Named("Title"),
                        ),
                    ),
                    Area(
                        id: 22,
                        content: Text(
                            root: [
                                Chars("A presentation is held in memory, or in a workspace: a directory with presentation.ron at its root and its images below it. The label at the right of the toolbar says which. In memory, Save as pack… writes one .rpk file that holds the presentation and its images, which Open pack… opens on any computer, and in the browser, a download; outside the browser, Save as workspace… writes it as a directory. A workspace saves itself after every change, and its .rootpoint/ folder holds what is the machine's and not the presentation's: its lock, its trash and the address of its window."),
                            ],
                            style: Named("Body"),
                        ),
                    ),
                ],
                dividers: [
                    0.25,
                ],
            ),
        ),
        (
            id: 24,
            root: Split(
                id: 27,
                axis: TopToBottom,
                children: [
                    Area(
                        id: 25,
                        content: Text(
                            root: [
                                Chars("Styling text"),
                            ],
                            style: Named("Title"),
                        ),
                    ),
                    Area(
                        id: 26,
                        content: Text(
                            root: [
                                Chars("While a text is edited, Ctrl+B makes what you type next "),
                                Span(
                                    id: 28,
                                    style: Custom(
                                        bold: true,
                                    ),
                                    text: [
                                        Chars("bold"),
                                    ],
                                ),
                                Chars(", Ctrl+I "),
                                Span(
                                    id: 29,
                                    style: Custom(
                                        italic: true,
                                    ),
                                    text: [
                                        Chars("italic"),
                                    ],
                                ),
                                Chars(", and the side panel sets a size, a colour or a "),
                                Span(
                                    id: 30,
                                    style: Named("Key"),
                                    text: [
                                        Chars("span style"),
                                    ],
                                ),
                                Chars(", over the selection when there is one. A frame shows "),
                                Span(
                                    id: 31,
                                    style: Custom(
                                        colour: (
                                            r: 200,
                                            g: 30,
                                            b: 30,
                                            a: 255,
                                        ),
                                    ),
                                    text: [
                                        Chars("each style that holds the caret, as "),
                                        Span(
                                            id: 32,
                                            style: Custom(
                                                size: 56.0,
                                            ),
                                            text: [
                                                Chars("here"),
                                            ],
                                        ),
                                    ],
                                ),
                                Chars(". The arrows enter a style at its edge and leave it; Ctrl+Space leaves the style the caret is in, or cuts it in two at the caret."),
                            ],
                            style: Named("Body"),
                        ),
                    ),
                ],
                dividers: [
                    0.25,
                ],
            ),
        ),
        (
            id: 33,
            root: Split(
                id: 37,
                axis: TopToBottom,
                children: [
                    Area(
                        id: 34,
                        content: Text(
                            root: [
                                Chars("Equations"),
                            ],
                            style: Named("Title"),
                        ),
                    ),
                    Area(
                        id: 35,
                        content: Equation(
                            formula: r#"\int_{-\infty}^{\infty} e^{-x^2}\,\mathrm{d}x = \sqrt{\pi}"#,
                            numbered: true,
                            size: Fit,
                            colour: (
                                r: 0,
                                g: 0,
                                b: 0,
                                a: 255,
                            ),
                        ),
                    ),
                    Area(
                        id: 36,
                        content: Text(
                            root: [
                                Chars("An equation area draws a formula written in LaTeX, numbered at its right edge in the order of the slides. Its options are in the side panel; the protocol's equation command sets its formula."),
                            ],
                            style: Named("Body"),
                        ),
                    ),
                ],
                dividers: [
                    0.25,
                    0.7,
                ],
            ),
        ),
    ],
)
