                                            g: 0,
                                            b: 0,
                                            a: 255,
                                        ),
                                        h_align: Center,
                                        v_align: Top,
                                    ),
                                ),
                            ),
                            Area(
                                id: 5,
                                content: Text(
                                    root: [
                                        Math(r#"x^2 \leq \frac{1}{2}"#),
                                        Ref(11),
